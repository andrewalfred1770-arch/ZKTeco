DATABASE_URL="mysql://root:123456789@localhost:3306/zkteco_attendance"
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3002

# ─── Security ───────────────────────────────────────────────────────────────
# AUTH_ENABLED=false  → Electron desktop mode: all API requests pass through (current default)
# AUTH_ENABLED=true   → LAN / Cloud mode: all API requests require a valid JWT
AUTH_ENABLED=false
JWT_SECRET=change-this-to-a-long-random-secret-before-lan-deployment
JWT_EXPIRES=8h
# Comma-separated list of allowed CORS origins (only enforced when AUTH_ENABLED=true)
CORS_ORIGINS=http://localhost:3002,http://localhost:5000
