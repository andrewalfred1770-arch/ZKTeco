generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  email     String?
  logo      String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  branches  Branch[]

  @@map("companies")
}

model Branch {
  id          Int              @id @default(autoincrement())
  name        String
  address     String?
  phone       String?
  companyId   Int
  status      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  rules       AttendanceRule[]
  company     Company          @relation(fields: [companyId], references: [id])
  departments Department[]
  devices     Device[]
  employees   Employee[]

  @@index([companyId], map: "branches_companyId_fkey")
  @@map("branches")
}

model Department {
  id        Int              @id @default(autoincrement())
  name      String
  branchId  Int
  status    Boolean          @default(true)
  createdAt DateTime         @default(now())
  rules     AttendanceRule[]
  branch    Branch           @relation(fields: [branchId], references: [id])
  employees Employee[]

  @@index([branchId], map: "departments_branchId_fkey")
  @@map("departments")
}

model Shift {
  id            Int        @id @default(autoincrement())
  name          String
  startTime     String
  endTime       String
  gracePeriod   Int        @default(0)
  overtimeStart String?
  nightShift    Boolean    @default(false)
  workingHours  Float      @default(8)
  breakMinutes  Int        @default(0)
  status        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  employees     Employee[]

  @@map("shifts")
}

model Employee {
  id               Int                    @id @default(autoincrement())
  name             String
  zkUserId         String
  code             String?                @unique
  phone            String?
  email            String?
  nationalId       String?
  position         String?
  hireDate         DateTime?
  salary           Float                  @default(0)
  departmentId     Int?
  branchId         Int
  shiftId          Int?
  userId           Int?                   @unique
  status           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  isMonitored      Boolean                @default(false)
  monitorColor     String?                @db.VarChar(20)
  advances         Advance[]
  adjustments      AttendanceAdjustment[]
  attendanceDaily  AttendanceDaily[]
  attendanceLogs   AttendanceLog[]
  branch           Branch                 @relation(fields: [branchId], references: [id])
  department       Department?            @relation(fields: [departmentId], references: [id])
  shift            Shift?                 @relation(fields: [shiftId], references: [id])
  user             User?                  @relation(fields: [userId], references: [id])
  manualEditAudits ManualEditAuditLog[]
  payrolls         Payroll[]

  @@index([branchId], map: "employees_branchId_fkey")
  @@index([departmentId], map: "employees_departmentId_fkey")
  @@index([shiftId], map: "employees_shiftId_fkey")
  @@map("employees")
}

model Device {
  id                      Int             @id @default(autoincrement())
  name                    String
  ipAddress               String
  port                    Int             @default(4370)
  branchId                Int
  lastSync                DateTime?
  status                  String          @default("offline")
  enabled                 Boolean         @default(true)
  createdAt               DateTime        @default(now())
  autoSync                Boolean         @default(true)
  consecutiveErrors       Int             @default(0)
  deviceNumber            Int             @default(1)
  errorMessage            String?
  lastSyncCount           Int             @default(0)
  syncInterval            Int             @default(5)
  totalLogsCount          Int             @default(0)
  isArchived              Boolean         @default(false)
  lastPullTotal           Int?
  lastSuccessfulTimestamp DateTime?
  logs                    AttendanceLog[]
  syncLogs                DeviceSyncLog[]
  branch                  Branch          @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "devices_branchId_fkey")
  @@map("devices")
}

model DeviceSyncLog {
  id                Int       @id @default(autoincrement())
  deviceId          Int
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  newLogs           Int       @default(0)
  totalLogs         Int       @default(0)
  status            String    @default("running")
  error             String?
  duration          Int?
  triggeredBy       String    @default("auto")
  convergencePasses Int?
  dbTotal           Int?
  duplicateCount    Int?
  invalidCount      Int?
  newestTimestamp   DateTime?
  oldestTimestamp   DateTime?
  returnedCount     Int?
  skippedOldCount   Int?
  zkErr             String?
  device            Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId], map: "device_sync_logs_deviceId_fkey")
  @@map("device_sync_logs")
}

model AttendanceLog {
  id          Int       @id @default(autoincrement())
  employeeId  Int?
  deviceId    Int
  zkUserId    String
  timestamp   DateTime
  verifyType  Int       @default(0)
  source      String    @default("device")
  isDuplicate Boolean   @default(false)
  createdAt   DateTime  @default(now())
  device      Device    @relation(fields: [deviceId], references: [id])
  employee    Employee? @relation(fields: [employeeId], references: [id])

  @@unique([deviceId, zkUserId, timestamp])
  @@index([zkUserId, employeeId])
  @@index([deviceId, timestamp])
  @@index([employeeId, timestamp])
  @@map("attendance_logs")
}

model AttendanceDaily {
  id                      Int                   @id @default(autoincrement())
  employeeId              Int
  date                    DateTime              @db.Date
  checkIn                 DateTime?
  checkOut                DateTime?
  workedMinutes           Int                   @default(0)
  lateMinutes             Int                   @default(0)
  overtimeMinutes         Int                   @default(0)
  overtimeHours           Float                 @default(0)
  earlyLeaveMinutes       Int                   @default(0)
  isAbsent                Boolean               @default(false)
  isHoliday               Boolean               @default(false)
  isWeekend               Boolean               @default(false)
  status                  String                @default("present")
  notes                   String?
  manualEdit              Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  earlyCheckoutUnits      Float                 @default(0)
  conditionDeductionUnits Float                 @default(0)
  eveningOvertimeHours    Float                 @default(0)
  latePenaltyUnits        Float                 @default(0)
  morningOvertimeHours    Float                 @default(0)
  totalDeductionUnits     Float                 @default(0)
  manualEarlyPenaltyUnits Float?
  manualConditionUnits    Float?
  manualLatePenaltyUnits  Float?
  manualPenaltyAt         DateTime?
  manualPenaltyBy         Int?
  manualPenaltyByName     String?
  manualPenaltyReason     String?               @db.Text
  manualOvertimeUnits     Float?
  overtimeRulesUnits      Float?
  absenceType             String?               @db.VarChar(30)
  penaltyDays             Float?                @db.Float
  absenceReason           String?               @db.Text
  absenceSetBy            String?               @db.VarChar(200)
  absenceSetAt            DateTime?
  adjustment              AttendanceAdjustment?
  employee                Employee              @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance_daily")
}

model AttendanceAdjustment {
  id                   Int                  @id @default(autoincrement())
  attendanceDailyId    Int                  @unique
  employeeId           Int
  date                 DateTime             @db.Date
  snapCheckIn          String?
  snapCheckOut         String?
  snapWorkedMinutes    Int                  @default(0)
  snapLateMinutes      Int                  @default(0)
  snapOvertimeHours    Float                @default(0)
  snapMorningOT        Float                @default(0)
  snapEveningOT        Float                @default(0)
  snapLatePenalty      Float                @default(0)
  snapEarlyPenalty     Float                @default(0)
  snapTotalDeductions  Float                @default(0)
  snapStatus           String               @default("present")
  snapIsAbsent         Boolean              @default(false)
  adjCheckIn           String?
  adjCheckOut          String?
  adjWorkedMinutes     Int?
  adjLateMinutes       Int?
  adjOvertimeHours     Float?
  adjMorningOT         Float?
  adjEveningOT         Float?
  adjLatePenalty       Float?
  adjEarlyPenalty      Float?
  adjConditionUnits    Float?
  adjTotalDeductions   Float?
  adjStatus            String?
  adjIsAbsent          Boolean?
  ignoreLate           Boolean              @default(false)
  ignoreEarlyLeave     Boolean              @default(false)
  ignoreConditionUnits Boolean              @default(false)
  forcePresent         Boolean              @default(false)
  approvalStatus       String               @default("pending")
  reason               String?              @db.Text
  hrComment            String?              @db.Text
  approvedBy           Int?
  approvedByName       String?
  approvedAt           DateTime?
  createdBy            Int                  @default(0)
  createdByName        String?
  createdByRole        String               @default("system")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  auditLogs            AdjustmentAuditLog[]
  attendanceDaily      AttendanceDaily      @relation(fields: [attendanceDailyId], references: [id])
  employee             Employee             @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "attendance_adjustments_employeeId_fkey")
  @@map("attendance_adjustments")
}

model ManualEditAuditLog {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  attendanceDailyId Int?
  payrollId         Int?
  fieldName         String
  oldValue          String?  @db.Text
  newValue          String?  @db.Text
  reason            String?  @db.Text
  modifiedBy        Int      @default(0)
  modifiedByName    String?
  modifiedByRole    String   @default("hr")
  createdAt         DateTime @default(now())
  source            String?  @default("inline-grid")
  employee          Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([attendanceDailyId])
  @@index([payrollId])
  @@map("manual_edit_audit_logs")
}

model AdjustmentAuditLog {
  id            Int                  @id @default(autoincrement())
  adjustmentId  Int
  action        String
  fieldName     String?
  oldValue      String?              @db.Text
  newValue      String?              @db.Text
  changedBy     Int                  @default(0)
  changedByName String?
  changedByRole String               @default("system")
  reason        String?              @db.Text
  changedAt     DateTime             @default(now())
  adjustment    AttendanceAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId], map: "adjustment_audit_logs_adjustmentId_fkey")
  @@map("adjustment_audit_logs")
}

model AttendanceRule {
  id           Int         @id @default(autoincrement())
  ruleKey      String
  ruleValue    String
  branchId     Int?
  departmentId Int?
  employeeId   Int?
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  branch       Branch?     @relation(fields: [branchId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([branchId], map: "attendance_rules_branchId_fkey")
  @@index([departmentId], map: "attendance_rules_departmentId_fkey")
  @@map("attendance_rules")
}

/// Database-driven business rules created/managed from the Rules page.
/// type    = number | percentage | boolean | time | text | formula
/// ('condition' removed permanently in EP-012 — no longer a valid value for new/edited rules)
/// value   = stored as String; `type` tells consumers how to coerce it
/// category= attendance | overtime | deductions | payroll | leaves | penalties | shifts | holidays
model Rule {
  id            Int         @id @default(autoincrement())
  name          String
  key           String      @unique
  category      String
  type          String      @default("number")
  value         String      @default(dbgenerated("(_utf8mb4\\'\\')")) @db.Text
  unit          String?
  priority      Int         @default(0)
  isActive      Boolean     @default(true)
  appliesTo     String      @default("all")
  conditionJson String?     @db.Text
  description   String?     @db.Text
  createdByName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  audits        RuleAudit[]

  @@index([category])
  @@map("rules")
}

/// Audit trail — one row per change to a Rule.
/// action = created | updated | enabled | disabled | deleted
model RuleAudit {
  id            Int      @id @default(autoincrement())
  ruleId        Int
  ruleKey       String?
  action        String
  fieldName     String?
  oldValue      String?  @db.Text
  newValue      String?  @db.Text
  changedByName String?  @default("النظام")
  changedAt     DateTime @default(now())
  rule          Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_audits")
}

model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime @db.Date
  branchId  Int?
  type      String   @default("public")
  createdAt DateTime @default(now())

  @@map("holidays")
}

/// Audit trail for "تنظيف الحركات" — one row per executed data-cleanup run.
/// status = preview | completed | failed
model CleanupLog {
  id                Int      @id @default(autoincrement())
  fromDate          DateTime @db.Date
  toDate            DateTime @db.Date
  dataTypes         String
  status            String   @default("completed")
  rawLogsDeleted    Int      @default(0)
  dailyDeleted      Int      @default(0)
  payrollDeleted    Int      @default(0)
  employeesAffected Int      @default(0)
  backupTaken       Boolean  @default(false)
  recalcTriggered   Boolean  @default(false)
  optimizeRun       Boolean  @default(false)
  durationMs        Int      @default(0)
  executedByName    String
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("cleanup_logs")
}

model Payroll {
  id                        Int      @id @default(autoincrement())
  employeeId                Int
  month                     Int
  year                      Int
  basicSalary               Float
  hourlyRate                Float
  workDays                  Int      @default(0)
  absentDays                Int      @default(0)
  latePenalty               Float    @default(0)
  overtimeHours             Float    @default(0)
  overtimeAmount            Float    @default(0)
  bonus                     Float    @default(0)
  advances                  Float    @default(0)
  deductions                Float    @default(0)
  netSalary                 Float
  status                    String   @default("draft")
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  eveningOTHours            Float    @default(0)
  morningOTHours            Float    @default(0)
  penaltyAmount             Float    @default(0)
  conditionPenaltyUnits     Float    @default(0)
  conditionPenaltyAmount    Float    @default(0)
  penaltyUnits              Float    @default(0)
  totalOTHours              Float    @default(0)
  manualDeductionAdjustment Float    @default(0)
  employee                  Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@index([month, year], map: "payroll_month_year_idx")
  @@map("payrolls")
}

model Advance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Float
  date       DateTime
  month      Int
  year       Int
  reason     String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "advances_employeeId_fkey")
  @@map("advances")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  role      String    @default("employee")
  name      String
  email     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  employee  Employee?

  @@map("users")
}

model CompanySetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  type      String   @default("text")
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("company_settings")
}

/// Tracks a single historical-rebuild run (recompute attendance_daily +
/// payrolls for a date range from existing AttendanceLog rows). Resumable via
/// cursorEmployeeId/cursorDate — see historicalRebuildService.js.
model HistoricalRebuildJob {
  id                 Int       @id @default(autoincrement())
  fromDate           DateTime  @db.Date
  toDate             DateTime  @db.Date
  employeeId         Int?
  status             String    @default("running")
  cursorEmployeeId   Int?
  cursorDate         DateTime? @db.Date
  totalEmployees     Int       @default(0)
  processedEmployees Int       @default(0)
  processedDates     Int       @default(0)
  errorCount         Int       @default(0)
  lastError          String?   @db.Text
  triggeredBy        String    @default("manual")
  reason             String?   @db.Text
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("historical_rebuild_jobs")
}

model CompanySettingAudit {
  id            Int      @id @default(autoincrement())
  settingKey    String
  action        String
  oldValue      String?  @db.Text
  newValue      String?  @db.Text
  changedByName String
  changedAt     DateTime @default(now())

  @@map("company_setting_audits")
}
