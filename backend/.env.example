# Copy this file to .env and fill in real values for your environment.
# NEVER commit the real .env file — it is git-ignored on purpose.

# MySQL connection string — replace user/password/host/port/database with
# this deployment's own credentials.
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3002

# ─── Security ───────────────────────────────────────────────────────────────
# AUTH_ENABLED=false  → Electron desktop mode: all API requests pass through. The backend then listens
#                       on 127.0.0.1 ONLY; setting HOST to a LAN address / 0.0.0.0 makes it refuse to start.
# AUTH_ENABLED=true   → LAN / Cloud mode: all API requests require a valid JWT. HOST unset = 0.0.0.0.
# (true/false in any letter case; any other value is treated as false and logged as a warning)
AUTH_ENABLED=false
# Generate a long random value per deployment — never reuse this example value.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES=8h
# Comma-separated list of allowed CORS origins (only enforced when AUTH_ENABLED=true)
CORS_ORIGINS=http://localhost:3002,http://localhost:5000
