# Mac Standalone Edition — loaded only by `vite build --mode standalone` (see
# package.json "build:standalone" script). Bakes VITE_EDITION into the bundle
# so src/lib/edition.js can gate Standalone-only UI (locked local-only
# Connection Settings, Backups panel). The default build (no --mode, i.e. the
# Server edition) has no .env file and falls back to 'server' in edition.js —
# this file must never be picked up by the plain "build" script.
VITE_EDITION=standalone
