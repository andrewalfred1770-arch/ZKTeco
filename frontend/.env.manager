# EP-011 — loaded only by `vite build --mode manager` (see package.json
# "build:manager" script). Bakes VITE_EDITION into the bundle so
# src/lib/edition.js can gate Manager-only UI. The default build (no --mode,
# i.e. the Server edition) has no .env file and falls back to 'server' in
# edition.js — this file must never be picked up by the plain "build" script.
VITE_EDITION=manager
