{
  "name": "petshrow-erp",
  "version": "2.22.0",
  "description": "PETSHROW ERP — نظام الموارد البشرية والرواتب",
  "author": "PETSHROW",
  "private": true,
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently --kill-others --names \"VITE,ELECTRON\" -c \"cyan,yellow\" \"vite\" \"wait-on http://localhost:3002 && electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:dir": "npm run build && electron-builder --win --x64 --dir",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:mac:dir": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.0.16",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@fontsource/tajawal": "^5.2.7",
    "ag-grid-community": "^31.2.0",
    "ag-grid-react": "^31.2.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.368.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.3",
    "socket.io-client": "^4.7.4",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.petshrow.erp",
    "productName": "PETSHROW ERP",
    "copyright": "© 2026 PETSHROW ERP",
    "asar": true,
    "asarUnpack": [
      "assets/**"
    ],
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "../backend",
          "to": "backend",
          "filter": [
            "**/*",
            "!backups/**",
            "!uploads/**",
            "!**/*.log",
            "!.env.example",
            "!node_modules/.cache/**",
            "!node_modules/.prisma/client/**/query_engine-windows*",
            "!node_modules/.prisma/client/**/libquery_engine-linux*",
            "!node_modules/.prisma/client/**/libquery_engine-debian*",
            "!node_modules/prisma/build/**",
            "!node_modules/.bin/**",
            "!**/*.md",
            "!**/*.ts",
            "!**/__tests__/**",
            "!**/test/**",
            "!**/tests/**"
          ]
        },
        {
          "from": "dist",
          "to": "frontend/dist",
          "filter": ["**/*"]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PETSHROW ERP",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "files": [
      "electron.js",
      "electron/**/*",
      "preload.cjs",
      "splashPreload.cjs",
      "assets/**/*",
      "!assets/*.psd",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!backups/**",
          "!uploads/**",
          "!**/*.log",
          "!.env.example",
          "!node_modules/.cache/**",
          "!node_modules/.prisma/client/**/libquery_engine-linux*",
          "!node_modules/.prisma/client/**/libquery_engine-darwin*",
          "!node_modules/.prisma/client/**/libquery_engine-debian*",
          "!node_modules/prisma/build/**",
          "!node_modules/.bin/**",
          "!**/*.md",
          "!**/*.ts",
          "!**/__tests__/**",
          "!**/test/**",
          "!**/tests/**"
        ]
      },
      {
        "from": "dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "../dist-electron"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.petshrow.local/erp/",
        "channel": "latest"
      }
    ]
  }
}
