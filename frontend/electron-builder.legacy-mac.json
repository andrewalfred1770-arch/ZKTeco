{
  "appId": "com.petshrow.erp.manager",
  "productName": "CheckIn Mac",
  "copyright": "© 2026 PETSHROW ERP",
  "asar": true,
  "asarUnpack": ["assets/**"],
  "compression": "normal",

  "electronVersion": "26.6.10",

  "extraMetadata": {
    "name": "petshrow-erp-manager",
    "main": "electron.mojave.cjs"
  },

  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64"] },
      { "target": "zip", "arch": ["x64"] }
    ],
    "icon": "assets/icon.png",
    "category": "public.app-category.business",
    "minimumSystemVersion": "10.13.0",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "artifactName": "CheckIn-Mac-Legacy-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      }
    ]
  },

  "dmg": {
    "artifactName": "CheckIn-Mac-Legacy-${version}-${arch}.${ext}"
  },

  "files": [
    "electron.mojave.cjs",
    "preload.cjs",
    "splashPreload.cjs",
    "assets/**/*",
    "!assets/*.psd",
    "!**/*.map",
    "!electron.js",
    "!electron/**/*"
  ],

  "directories": {
    "buildResources": "assets",
    "output": "../dist-electron-legacy"
  }
}
